# Ativa o módulo de reescrita de URLs do Apache
RewriteEngine On

# Só executa a regra se a URL NÃO começar com /Aptus/public/
# (evita loop infinito de reescrita)
RewriteCond %{REQUEST_URI} !^/Aptus/public/

# Encaminha qualquer requisição para a pasta public
#
# Exemplos:
# /Aptus           -> /Aptus/public/
# /Aptus/buscar    -> /Aptus/public/buscar
# /Aptus/anuncios  -> /Aptus/public/anuncios
#
# ^(.*)$ captura toda a URL solicitada; $1 é o que foi capturado
# [L] = "Last": para de processar outras regras
RewriteRule ^(.*)$ public/$1 [L]
